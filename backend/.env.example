# Copy to .env and fill in. Never commit the real .env.
# The server checks these at boot (src/config/env.js) and refuses to start in
# production if a REQUIRED one is missing or weak.

# ── REQUIRED ────────────────────────────────────────────────────────────────
NODE_ENV=production
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/schoolflo
# At least 32 characters, and two DIFFERENT values. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
# The web client's address. Several origins may be listed, comma separated, for
# CORS; the FIRST one is used in links sent by email and to payment gateways.
CLIENT_URL=https://your-school.vercel.app

# ── Token lifetimes (defaults shown) ────────────────────────────────────────
JWT_EXPIRE=1h
JWT_REFRESH_EXPIRE=30d

# ── School identity, printed on report cards, certificates and letters ──────
SCHOOL_NAME=
SCHOOL_ADDRESS=
SCHOOL_PHONE=
SCHOOL_EMAIL=

# ── Email (without it no welcome, reset or receipt email is sent) ───────────
# Resend's API key, sent over HTTPS. Use this on any host that blocks outbound
# SMTP (Render's free plan does). When set, the SMTP_* settings are ignored.
# RESEND_API_KEY=
# Otherwise, any SMTP server:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_NAME=
FROM_EMAIL=

# ── File storage (uploads; certificate PDFs live in MongoDB) ────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Card payments (only if online payments are enabled) ─────────────────────
# Webhook URL to set in the Paystack dashboard: https://<api-host>/webhooks/paystack
PAYSTACK_SECRET_KEY=
# Flutterwave is optional. Its dashboard "secret hash" goes here, and its
# webhook URL is https://<api-host>/webhooks/flutterwave
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# ── Which features this school runs (see DOCUMENTATION.md §4a) ──────────────
# SCHOOL_PROFILE=full            # or: office-fees
# FEATURE_STAFF_ATTENDANCE=true
# FEATURE_ONLINE_PAYMENTS=true

# ── Optional ────────────────────────────────────────────────────────────────
# PORT=5000
# RATE_LIMIT_MAX=600
# RATE_LIMIT_WINDOW_MINUTES=15
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_PER_HOST=200
# SCHOOL_UTC_OFFSET_MINUTES=60
# SCHOOL_DAY_START=08:00
# SCHOOL_DAY_END=15:30
# SCHOOL_LATE_GRACE_MINUTES=10
# KEEP_ALIVE=true
# This deployment's own address. On Render, RENDER_EXTERNAL_URL is used if unset.
# PING_URL=https://your-api-host/keep-alive
# Only for a local mail server with a self-signed certificate.
# SMTP_ALLOW_SELF_SIGNED=false
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── First admin only: used once by `pnpm seed`, then remove from .env ───────
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
