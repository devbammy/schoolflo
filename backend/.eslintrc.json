{
  "root": true,
  "env": {
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "extends": ["eslint:recommended", "prettier"],
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_|^next$",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "no-console": "off",
    "no-process-exit": "off",
    "eqeqeq": ["warn", "smart"],
    "no-var": "error",
    "prefer-const": "warn",
    "no-return-await": "warn",
    "require-await": "off"
  },
  "overrides": [
    {
      "files": ["tests/**/*.js"],
      "env": { "jest": true },
      "plugins": ["jest"],
      "extends": ["plugin:jest/recommended"]
    }
  ],
  "ignorePatterns": ["node_modules/", "coverage/", "dist/"]
}
