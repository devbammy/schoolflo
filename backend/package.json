{
  "name": "smp-backend",
  "version": "1.0.0",
  "description": "School Management Portal - Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "echo Build complete",
    "seed": "node src/utils/seed.js",
    "migrate:scores": "node src/utils/migrateScoreBreakdown.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" server.js",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" server.js",
    "reconcile": "node src/utils/reconcilePayments.js",
    "reconcile:apply": "node src/utils/reconcilePayments.js --apply",
    "migrate:certificates": "node src/utils/migrateCertificatePdfs.js",
    "migrate:certificates:apply": "node src/utils/migrateCertificatePdfs.js --apply"
  },
  "dependencies": {
    "@agendajs/mongo-backend": "^4.0.3",
    "agenda": "^6.2.6",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-async-errors": "^3.1.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.4",
    "morgan": "^1.12.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.13",
    "pdfkit": "^0.18.0",
    "twilio": "^4.19.3"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.1",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  }
}
